<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.epam.automation.testing.listener.TestListener"/>
    </listeners>

    <!-- Chrome tests -->
    <test name="Chrome - Positive Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.epam.automation.testing.PositiveLoginTest"/>
        </classes>
    </test>

    <test name="Chrome - Negative Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.epam.automation.testing.NegativeLoginTest"/>
        </classes>
    </test>

    <!-- Firefox tests -->
    <test name="Firefox - Positive Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.epam.automation.testing.PositiveLoginTest"/>
        </classes>
    </test>

    <test name="Firefox - Negative Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.epam.automation.testing.NegativeLoginTest"/>
        </classes>
    </test>

</suite>
